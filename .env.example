# DataForge AI Configuration

# LLM Provider Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000

# API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# File Processing
MAX_FILE_SIZE_MB=100
MAX_ROWS=1000000
MAX_COLUMNS=1000

# Execution
MAX_RETRIES=3
EXECUTION_TIMEOUT=300

# Output
DEFAULT_OUTPUT_DIR=./output

# Visualization
MAX_VISUALIZATIONS=6
VISUALIZATION_WIDTH=1200
VISUALIZATION_HEIGHT=800
VISUALIZATION_SCALE=2
VISUALIZATION_DPI=300