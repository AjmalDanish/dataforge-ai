# DataForge AI configuration (copy to .env; every value is optional)

# --- LLM (optional) -------------------------------------------------------
# Without a key the engine runs fully rule-based. With one, the LLM writes the
# executive narrative + recommendations, breaks ties in domain detection, and
# generates business objectives.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# anthropic | openai — defaults to the first provider with a key (Anthropic first)
LLM_PROVIDER=
# Defaults: claude-opus-5-5 (Anthropic) / gpt-4o (OpenAI)
LLM_MODEL=
LLM_TIMEOUT=120
# Set to 1 to force the rule-based path even when a key is present
DATAFORGE_DISABLE_LLM=

# --- Engine -----------------------------------------------------------------
# Multiply every agent's timeout (raise for very large datasets)
DATAFORGE_TIMEOUT_SCALE=1
MAX_FILE_SIZE_MB=100
MAX_ROWS=1000000
DEFAULT_OUTPUT_DIR=./output

# --- API server (backend/app.py) -------------------------------------------
# Comma-separated allowed CORS origins ("*" allows any)
FRONTEND_URL=*
UPLOAD_DIR=./backend/uploads
OUTPUT_DIR=./backend/outputs
MAX_CONCURRENT_RUNS=2
# Admin override for DELETE /api/runs/{id} (header X-Admin-Token); owners can always delete
DATAFORGE_ADMIN_TOKEN=

# --- Accounts & rate limits ---------------------------------------------------
# Clerk instance URL ("Frontend API URL" in the Clerk dashboard). Unset = dev mode:
# every request acts as one local user (fine locally, never on a public server).
CLERK_ISSUER=
# 1 = refuse dev mode: without CLERK_ISSUER everyone is anonymous (samples only)
DATAFORGE_REQUIRE_AUTH=
USER_RUNS_PER_HOUR=10
ANON_RUNS_PER_HOUR=5
# Proxies in front of the API that append to X-Forwarded-For (1 = one load balancer; Render needs 2)
TRUSTED_PROXY_HOPS=1

# --- Frontend (frontend/.env.local) ----------------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_MAX_UPLOAD_MB=25
# Clerk keys (leave unset for dev mode; both are required to enable sign-in)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
# CLERK_SECRET_KEY=sk_...
